Options -MultiViews
RewriteEngine On

# Old English URL → homepage
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^en\.html$ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
